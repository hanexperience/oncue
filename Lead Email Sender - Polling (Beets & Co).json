    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nconst address = lead.address || '';\nconst suburbMatch = address.match(/,\\s*([A-Za-z\\s]+?)\\s+VIC\\s+\\d{4}/i);\nconst suburb = suburbMatch ? suburbMatch[1].trim() : null;\n\n// Build a unique, readable ref slug from company name + short place_id suffix\nfunction slugify(str) {\n  return str\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/(^-|-$)/g, '');\n}\n\nconst baseSlug = slugify(lead.company_name || 'lead');\nconst shortId = (lead.place_id || '').slice(-6); // last 6 chars, guarantees uniqueness\nconst refSlug = `${baseSlug}-${shortId}`;\n\nconst trackingUrl = `https://beetsandco.com.au/crowncon/?ref=${refSlug}`;\n\nconst subject = `Saying hello, fellow local business`;\n\nconst SIGNATURE_HTML = `\n<div style=\"margin-top:18px;padding-top:10px;border-top:1px solid #e2e2e2;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#6b6b6b;line-height:1.5;\">\n<div style=\"color:#333;font-weight:bold;\">Michael Beets</div>\n<div>Beets &amp; Co. &mdash; Creative Director &amp; Founder</div>\n<div><a href=\"https://www.beetsandco.com.au/\" style=\"color:#6b6b6b;text-decoration:none;\">https://www.beetsandco.com.au/</a></div>\n<div>(+61) 0447542930</div>\n</div>`;\n\nconst body = `<p>Hi there,</p>\n<p>I'm Michael from Beets & Co.&mdash; and I take care of website, search rankings, and video content for companies in Bayside / South East Melbourne.</p>\n<p>One recent project worth a look: a full rebrand, website, video and content overhaul for Crowncon, a custom home builder in the area &mdash; <a href=\"${trackingUrl}\">beetsandco.com.au/crowncon</a></p>\n<p>What I focus on is giving businesses an actual voice through video and story, making sure they're seen across the web, and standing out rather than the generic, everything-looks-AI-generated feel most small business sites have now.</p>\n<p>If you're keen to have a chat, please let me know.</p>\n<p>Michael</p>\n${SIGNATURE_HTML}`;\n\nreturn [{\n  json: {\n    email_job_id: $('Set Email Vars').item.json.email_job_id,\n    place_id: lead.place_id,\n    contact_email: lead.contact_email,\n    company_name: lead.company_name,\n    ref_slug: refSlug,\n    suburb,\n    subject,\n    body\n  }\n}];"
      },
