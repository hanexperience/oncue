    {
      "parameters": {
        "jsCode": "const lead = ($('Get Lead').first().json) || {};\nconst clickId = $('Set Click Vars').item.json.click_id;\nconst refSlug = $('Set Click Vars').item.json.ref_slug;\nconst clickedAt = $('Set Click Vars').item.json.clicked_at;\nconst userAgent = $('Set Click Vars').item.json.user_agent || 'unknown device';\n\nconst companyName = lead.company_name || '(unknown company — no matching lead for this ref)';\nconst contactEmail = lead.contact_email || '—';\nconst placeId = lead.place_id || null;\n\nconst clickedDate = new Date(clickedAt);\nconst clickedFormatted = clickedDate.toLocaleString('en-AU', { timeZone: 'Australia/Melbourne', dateStyle: 'medium', timeStyle: 'short' });\n\nconst subject = `Link opened: ${companyName}`;\n\nconst body = `<p><strong>${companyName}</strong> just opened the link from your outreach email.</p>\n<p>Contact email: ${contactEmail}<br>\nOpened: ${clickedFormatted}<br>\nRef: ${refSlug}<br>\nDevice: ${userAgent}</p>\n<p>Check the Leads tab in your Business admin to follow up and mark it off.</p>`;\n\nreturn [{\n  json: {\n    click_id: clickId,\n    place_id: placeId,\n    ref_slug: refSlug,\n    subject,\n    body\n  }\n}];"
      },
