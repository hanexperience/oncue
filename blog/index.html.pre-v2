<style>
/* journal index — maps the page's existing classes onto the v2 system */
.container{max-width:1400px;margin:0 auto;padding:0 var(--pad)}
.nav{position:sticky;top:0;z-index:80;background:rgba(11,13,10,.86);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--rule)}
.nav .container.row{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:15px var(--pad)}
.brand .wm{font-family:var(--grot);font-weight:600;font-size:20px;letter-spacing:-.03em;color:var(--paper)}
.brand .amp{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--stone)}
.nav-links{display:flex;align-items:center;gap:clamp(14px,1.8vw,30px)}
.nav-links a{font-size:16px;font-weight:500;color:var(--stone);transition:color .25s ease}
.nav-links a:hover{color:var(--paper)}
.nav-cta .btn svg{width:15px;height:15px;margin-left:8px}
.burger{display:none;background:none;border:1px solid var(--rule);color:var(--paper);
  font-family:var(--grot);font-weight:600;font-size:15px;padding:10px 16px;border-radius:2px;cursor:pointer}

.journal-hero{padding:clamp(60px,8vw,124px) 0 clamp(34px,4vw,56px)}
.journal-hero h1{font-size:clamp(42px,7vw,110px);line-height:.92;letter-spacing:-.045em;font-weight:600;max-width:15ch;text-wrap:balance}
.journal-hero .sub{margin-top:clamp(22px,2.6vw,34px);font-size:clamp(18px,1.7vw,22px);
  line-height:1.45;color:var(--stone);max-width:58ch}
.serif-em{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:-.015em}

.journal-grid-page{padding:0 0 clamp(70px,9vw,130px)}
.grid-layout{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:clamp(20px,2.6vw,34px)}
.post-card{display:flex;flex-direction:column;background:var(--soil-3);
  border:1px solid rgba(242,239,230,.08);border-radius:3px;
  transition:background .3s ease,transform .4s cubic-bezier(.16,.84,.28,1)}
.post-card:hover{background:#22271F;transform:translateY(-3px)}
.card-top{display:none}
.card-body{display:flex;flex-direction:column;gap:13px;padding:clamp(24px,2.6vw,34px);height:100%}
.post-card .cat{font-size:16px;color:var(--stone-2)}
.post-card h3{font-family:var(--grot);font-weight:600;font-size:clamp(21px,2.2vw,27px);
  letter-spacing:-.03em;line-height:1.1;margin:0}
.post-card p{font-size:17px;line-height:1.45;color:var(--stone);margin:0}
.post-card .rd{margin-top:auto;padding-top:10px;display:inline-flex;align-items:center;gap:9px;
  font-family:var(--grot);font-weight:600;font-size:17px;color:var(--beet)}
.post-card .rd svg{width:17px;height:17px}

footer{padding:clamp(56px,6vw,90px) 0 44px;border-top:1px solid var(--rule);margin-top:clamp(20px,3vw,40px)}
.foot-top{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:clamp(24px,3vw,48px)}
.foot-brand p{font-size:17px;color:var(--stone-2);margin-top:14px;max-width:42ch;line-height:1.45}
.foot-col h4{margin:0 0 14px;font-family:var(--grot);font-weight:600;font-size:17px;
  letter-spacing:-.02em;color:var(--paper)}
.foot-col a{display:block;color:var(--stone-2);font-size:16px;margin-bottom:9px;transition:color .25s ease}
.foot-col a:hover{color:var(--beet)}

@media(max-width:900px){
  .nav-links{display:none}
  .burger{display:block}
  .foot-top{grid-template-columns:1fr;gap:30px}
}
</style>
